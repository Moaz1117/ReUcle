{
    "name":  "analytics-service",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "build":  "nest build",
                    "start":  "node dist/main.js",
                    "start:dev":  "nest start --watch",
                    "test":  "jest --passWithNoTests"
                },
    "dependencies":  {
                         "@nestjs/common":  "^11.0.0",
                         "@nestjs/core":  "^11.0.0",
                         "@nestjs/platform-express":  "^11.0.0",
                         "class-transformer":  "^0.5.1",
                         "class-validator":  "^0.14.1",
                         "reflect-metadata":  "^0.2.2",
                         "rxjs":  "^7.8.1"
                     },
    "devDependencies":  {
                            "@nestjs/cli":  "^11.0.0",
                            "@types/jest":  "^29.5.12",
                            "@types/node":  "^22.0.0",
                            "jest":  "^29.7.0",
                            "ts-jest":  "^29.2.0",
                            "typescript":  "^5.6.0"
                        },
    "jest":  {
                 "moduleFileExtensions":  [
                                              "js",
                                              "json",
                                              "ts"
                                          ],
                 "rootDir":  "src",
                 "testRegex":  ".*\\.spec\\.ts$",
                 "transform":  {
                                   "^.+\\.ts$":  "ts-jest"
                               },
                 "testEnvironment":  "node"
             }
}
